+(defn- rename-path-name
+  "Compose the full path string used by the library rename events from an
+  item and a new name. A `value` that contains a path separator is
+  interpreted as an absolute path (matching the UI rename field); any
+  other value keeps the item's current path. This makes the setters
+  idempotent: assigning back a value read from `name`/`path` (e.g.
+  \"Group / Name\") no longer appends the current path again and moves
+  the element to a nested group on every set."
+  [item value]
+  (if (str/includes? value "/")
+    value
+    (cpn/merge-path-item (d/nilv (:path item) "") value)))
+
 (defn lib-color-proxy? [p]
   (obj/type-of? p "LibraryColorProxy"))
 
